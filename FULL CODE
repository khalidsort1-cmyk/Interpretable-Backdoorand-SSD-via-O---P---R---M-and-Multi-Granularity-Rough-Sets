    plt.tight_layout(); plt.savefig(path, dpi=300); plt.close()

def plot_cm(y, preds, names, path):
    n = len(names); c = min(3, n); r = int(np.ceil(n / c))
    fig, axes = plt.subplots(r, c, figsize=(5 * c, 4 * r))
    axes = np.array(axes).flatten() if n > 1 else np.array([axes])
    i = 0
    for i, nm in enumerate(names):
        if nm not in preds: continue
        cm = confusion_matrix(y, preds[nm], normalize='true')
        sns.heatmap(cm, annot=True, fmt='.2f', cmap='Blues', cbar=False,
                    ax=axes[i], xticklabels=['Benign', 'Attack'],
                    yticklabels=['Benign', 'Attack'])
        axes[i].set_title(nm, fontsize=8)
    for j in range(i + 1, len(axes)): axes[j].axis('off')
    plt.tight_layout(); plt.savefig(path, dpi=300); plt.close()

def plot_imp(clf, title, path):
    imp = clf.get_feature_importance()
    if not imp: return
    s = sorted(imp.items(), key=lambda x: x[1], reverse=True)[:25]
    f, v = zip(*s)
    plt.figure(figsize=(10, 7)); plt.barh(f, v); plt.xlabel('Importance')
    plt.title(title); plt.tight_layout(); plt.savefig(path, dpi=300); plt.close()

def extract_rules(clf):
    rules = []
    if hasattr(clf, 'rules'):
        for col, b, cls, cf in clf.rules:
            e = clf.bins.get(col, [])
            if len(e) == 0: rng = f'Bin {b}'
            elif b == 0: rng = f'≤ {e[0]:.4f}'
            elif b >= len(e): rng = f'> {e[-1]:.4f}'
            else: rng = f'({e[b-1]:.4f}, {e[b]:.4f}]'
            rules.append({'Feature': col, 'Range': rng,
                          'Class': 'Attack' if cls == 1 else 'Benign',
                          'Confidence': cf})
    df = pd.DataFrame(rules)
    if not df.empty: df = df.sort_values('Confidence', ascending=False)
    return df

def mcnemar(y, p1, p2):
    if not HAS_SM:
        return None
    bc = bw = a = b = 0
    for t, x, z in zip(y, p1, p2):
        if x == t and z == t: bc += 1
        elif x != t and z != t: bw += 1
        elif x == t: a += 1
        else: b += 1
    if a + b == 0:
        return 1.0
    try:
        return _sm_mcnemar([[bc, a], [b, bw]], exact=True, correction=True).pvalue
    except Exception:
        return None

