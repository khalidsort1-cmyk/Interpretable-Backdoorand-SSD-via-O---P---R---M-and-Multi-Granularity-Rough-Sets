class RoughSetClassifier:
    def __init__(self, n_bins=8, feature_subset=None, min_class_size=3,
                 min_samples_per_bin=5, min_confidence=0.5):
        self.n_bins = n_bins; self.feature_subset = feature_subset
        self.min_class_size = min_class_size
        self.min_samples_per_bin = min_samples_per_bin
        self.min_confidence = min_confidence
        self.bins, self.feature_names = {}, []
        self.equiv_class_to_counts = {}
        self.lower_approx, self.upper_approx = {}, {}
        self.upper_approx_membership = {}
        self.rules, self.rule_index = [], {}
        self.majority_class = 0; self.is_fitted = False

    def fit(self, X, y):
        if isinstance(X, pd.DataFrame):
            if self.feature_subset is not None:
                X = X[self.feature_subset]
            self.feature_names = X.columns.tolist()
            Xa = X.values.astype(float)
        else:
            self.feature_names = [f'f{i}' for i in range(X.shape[1])]
            Xa = np.asarray(X, dtype=float)
        y = y.values if isinstance(y, pd.Series) else np.asarray(y)
        self.majority_class = int(Counter(y.tolist()).most_common(1)[0][0])
        self.bins = {}
        for i, col in enumerate(self.feature_names):
            v = Xa[:, i]; u = np.unique(v)
            if len(u) <= 1: self.bins[col] = np.array([]); continue
            nb = min(self.n_bins, max(2, len(u) - 1))
            qs = np.linspace(0, 100, nb + 1)[1:-1]
            self.bins[col] = np.unique(np.percentile(v, qs))
        Xd = self._disc(Xa)
        self.equiv_class_to_counts = {}
        for r, l in zip(Xd, y):
            key = tuple(int(v) for v in r)
            self.equiv_class_to_counts.setdefault(key, Counter())[int(l)] += 1
        self.lower_approx, self.upper_approx = {}, {}
        self.upper_approx_membership = {}
        for key, cnts in self.equiv_class_to_counts.items():
            tot = sum(cnts.values())
            for c in set(int(x) for x in y):
                n_c = cnts.get(c, 0)
                if n_c > 0:
                    self.upper_approx.setdefault(c, set()).add(key)
                    self.upper_approx_membership.setdefault(c, {})[key] = n_c / tot
                if n_c == tot:
                    self.lower_approx.setdefault(c, set()).add(key)
        rv = {}
        for key, cnts in self.equiv_class_to_counts.items():
            tot = sum(cnts.values())
            if tot < self.min_class_size: continue
            for i, b in enumerate(key):
                col = self.feature_names[i]
                slot = rv.setdefault((col, b), Counter())
                for c, x in cnts.items(): slot[c] += x
        self.rules, self.rule_index = [], {}
        for (col, b), votes in rv.items():
            tot = sum(votes.values())
            if tot < self.min_samples_per_bin: continue
            mc, cnt = votes.most_common(1)[0]
            cf = cnt / tot
            if cf >= self.min_confidence:
                self.rules.append((col, b, int(mc), float(cf)))
        self.rules.sort(key=lambda x: x[3], reverse=True)
        for (col, b, c, cf) in self.rules:
            self.rule_index.setdefault((col, b), []).append((c, cf))
        self.is_fitted = True
        return self

    def _disc(self, Xa):
        out = np.zeros((Xa.shape[0], len(self.feature_names)), dtype=int)
        for i, col in enumerate(self.feature_names):
            e = self.bins.get(col, np.array([]))
            out[:, i] = 0 if len(e) == 0 else np.digitize(Xa[:, i], e, right=False)
        return out

    def _vote(self, key):
        v = Counter()
        for i, b in enumerate(key):
            col = self.feature_names[i]
            for (c, cf) in self.rule_index.get((col, b), []):
                v[c] += cf
        return v.most_common(1)[0][0] if v else self.majority_class

    def _classify(self, key):
        for c, ks in self.lower_approx.items():
            if key in ks: return c
        best, bm = self.majority_class, -1.0
        for c, km in self.upper_approx_membership.items():
            if key in km and km[key] > bm:
                bm, best = km[key], c
        return best if bm > 0 else self._vote(key)

    def predict(self, X):
        if isinstance(X, pd.DataFrame):
            if self.feature_subset is not None:
                X = X[self.feature_subset]
            Xa = X.values.astype(float)
        else:
            Xa = np.asarray(X, dtype=float)
        Xd = self._disc(Xa)
        return np.array([self._classify(tuple(int(v) for v in r)) for r in Xd])

    def predict_proba(self, X):
        if isinstance(X, pd.DataFrame):
            if self.feature_subset is not None:
                X = X[self.feature_subset]
            Xa = X.values.astype(float)
        else:
            Xa = np.asarray(X, dtype=float)
        Xd = self._disc(Xa)
        out = []
        for r in Xd:
            key = tuple(int(v) for v in r)
            m0 = self.upper_approx_membership.get(0, {}).get(key, 0.0)
            m1 = self.upper_approx_membership.get(1, {}).get(key, 0.0)
            t = m0 + m1
            out.append([m0 / t, m1 / t] if t > 0 else [0.5, 0.5])
        return np.array(out)

    def get_feature_importance(self):
        imp = Counter()
        for k, c in self.equiv_class_to_counts.items():
            t = sum(c.values())
            if t < self.min_class_size: continue
            _, top = c.most_common(1)[0]
            if top / t < self.min_confidence: continue
            for col in self.feature_names: imp[col] += top / t
        return dict(imp)

