def _kac_from_chain(chain, is_mal, kac_mean_mal=0.92, kac_std_mal=0.05,
                    kac_mean_ben=0.25, kac_std_ben=0.15):
    if is_mal:
        rep = np.random.randint(4, 9)
        sm = float(np.clip(np.random.normal(kac_mean_mal, kac_std_mal), 0, 1))
        im = float(np.clip(np.random.normal(kac_mean_mal, kac_std_mal), 0, 1))
        sd = float(np.clip(np.random.normal(kac_mean_mal, kac_std_mal), 0, 1))
        bm = float(np.clip(np.random.normal(kac_mean_mal, kac_std_mal), 0, 1))
    else:
        rep = int(np.random.choice([0, 1, 1, 2], p=[0.4, 0.35, 0.15, 0.10]))
        sm = float(np.clip(np.random.normal(kac_mean_ben, kac_std_ben), 0, 1))
        im = float(np.clip(np.random.normal(kac_mean_ben, kac_std_ben), 0, 1))
        sd = float(np.clip(np.random.normal(kac_mean_ben, kac_std_ben), 0, 1))
        bm = float(np.clip(np.random.normal(kac_mean_ben, kac_std_ben), 0, 1))
    engine = KhalidAlminshidEngine()
    tmp = pd.DataFrame([{'out_pkt_repetition_count': rep,
                         'out_pkt_size_match': sm, 'out_pkt_interval_match': im,
                         'out_pkt_same_dest_port_ratio': sd, 'out_pkt_byte_match': bm}])
    risk = float(engine.score(tmp)[0])
    s_pkts = float(rep if rep > 0 else np.random.randint(1, 5))
    s_bytes = float(s_pkts * np.random.uniform(40, 400))
    return {
        'out_pkt_repetition_count': float(rep),
        'out_pkt_size_match': sm, 'out_pkt_interval_match': im,
        'out_pkt_same_dest_port_ratio': sd, 'out_pkt_byte_match': bm,
        'khalid_risk_score': risk,
        'out_src_pkts': s_pkts,
        'out_src_bytes': s_bytes,
        'out_src_mean_size': float(s_bytes / s_pkts),
        'out_src_inter_pkt': float(np.random.exponential(0.5 if is_mal else 5.0)),
        'out_src_jitter': float(np.random.exponential(0.2 if is_mal else 2.0)),
        'out_src_win': float(np.random.randint(0, 65535)),
        'out_src_tcp_base': float(np.random.randint(0, 2**32)),
        'out_src_ttl': float(np.random.choice([32, 64, 128, 255])),
        'out_src_load': float(np.random.uniform(0, 1e6)),
        'out_src_loss': float(np.random.uniform(0, 1)),
        'out_src_header_len': float(np.random.uniform(20, 60)),
        'out_src_rate': float(np.random.uniform(0, 1000)),
        'out_src_max_pkt': float(np.random.uniform(40, 1500)),
        'out_src_min_pkt': float(np.random.uniform(0, 40)),
        'out_src_std_pkt': float(np.random.uniform(0, 100)),
        'out_src_iat_total': float(np.random.exponential(2.0)),
        'out_src_iat_max': float(np.random.exponential(1.0)),
        'out_src_iat_min': float(np.random.exponential(0.05)),
        'out_src_psh_flags': float(np.random.randint(0, 5)),
        'out_src_urg_flags': float(np.random.randint(0, 3)),
        'spkts': s_pkts,
        'dpkts': float(np.random.randint(1, 5)),
        'sbytes': s_bytes,
