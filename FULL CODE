def load_folder(folder):
    csvs = glob.glob(os.path.join(folder, '*.csv'))
    skip = ['feature', 'list_events', 'description', 'readme']
    files = [f for f in csvs if not any(p in os.path.basename(f).lower() for p in skip)]
    frames = []
    for f in files:
        print(f"   - {os.path.basename(f)}")
        try: df = pd.read_csv(f)
        except: continue
        if df.empty or len(df.columns) < 5: continue
        frames.append(df)
    df = pd.concat(frames, ignore_index=True)
    print(f"   Combined: {df.shape}")
    cand = ['label', 'labels', 'class', 'attack_cat', 'attack',
            'malicious', 'target', 'type']
    cs = {c.strip().lower(): c for c in df.columns}
    lc = next((cs[n] for n in cand if n in cs), None)
    if lc and lc != 'label': df.rename(columns={lc: 'label'}, inplace=True)
    benign = {'benign', 'normal', 'good', '0', 'false', 'no'}
    def b(v):
        if pd.isna(v): return np.nan
        x = str(v).strip().lower()
        if x == '': return np.nan
        if x in benign: return 0
        try:
            if float(x) == 0: return 0
        except: pass
        return 1
    df['label'] = df['label'].astype(str).apply(b)
    df = df.dropna(subset=['label'])
    df['label'] = df['label'].astype(int)
    print(f"   Labels: {df['label'].value_counts().to_dict()}")
    return df

