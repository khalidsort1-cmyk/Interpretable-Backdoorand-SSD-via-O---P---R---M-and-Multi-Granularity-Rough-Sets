# 2. KHALID ALMINSHID ENGINE
# =============================================================================
class KhalidAlminshidEngine:
    def __init__(self, w_rep=0.30, w_size=0.25, w_int=0.20, w_dst=0.15,
                 w_byte=0.10, threshold=0.5, min_rep=2):
        self.w_rep, self.w_size, self.w_int = w_rep, w_size, w_int
        self.w_dst, self.w_byte = w_dst, w_byte
        self.threshold, self.min_rep = threshold, min_rep

    def score(self, df):
        need = ['out_pkt_repetition_count', 'out_pkt_size_match',
                'out_pkt_interval_match', 'out_pkt_same_dest_port_ratio',
                'out_pkt_byte_match']
        if not all(c in df.columns for c in need):
            return np.full(len(df), 0.5)
        rep = df['out_pkt_repetition_count'].values.astype(float)
        sm = df['out_pkt_size_match'].clip(0, 1).values
        im = df['out_pkt_interval_match'].clip(0, 1).values
        sd = df['out_pkt_same_dest_port_ratio'].clip(0, 1).values
        bm = df['out_pkt_byte_match'].clip(0, 1).values
        rep_norm = 1.0 - np.exp(-(rep - self.min_rep).clip(0, None) / 3.0)
        s = (self.w_rep * rep_norm + self.w_size * sm + self.w_int * im +
             self.w_dst * sd + self.w_byte * bm)
        match = ((rep >= self.min_rep) & (sm >= 0.8) &
                 (im >= 0.8) & (sd >= 0.5)).astype(float)
        return np.clip(s + 0.15 * match, 0.0, 1.0)

    def flag(self, df):
        return (self.score(df) >= self.threshold).astype(int)

# =============================================================================
# 3. KHALID ALMINSHID FLAT CLASSIFIER
# =============================================================================
class KhalidAlminshidClassifier:
    def __init__(self, feature_subset=None):
        self.feature_subset = feature_subset
        self.engine = KhalidAlminshidEngine()
        self.best_threshold = 0.5
        self.majority_class = 0
        self.has_features = False
        self.is_fitted = False
        self.rules, self.bins = [], {}
        self.feature_weights = {
            'out_pkt_repetition_count': 0.30,
            'out_pkt_size_match': 0.25,
            'out_pkt_interval_match': 0.20,
            'out_pkt_same_dest_port_ratio': 0.15,
            'out_pkt_byte_match': 0.10}

    def _ok(self, X):
        need = ['out_pkt_repetition_count', 'out_pkt_size_match',
                'out_pkt_interval_match', 'out_pkt_same_dest_port_ratio',
                'out_pkt_byte_match']
        return all(c in X.columns for c in need)

    def fit(self, X, y):
        yv = y.values if isinstance(y, pd.Series) else np.asarray(y)
        self.majority_class = int(np.argmax(np.bincount(yv.astype(int))))
        if not self._ok(X):
            self.has_features = False
            self.is_fitted = True
            return self
        self.has_features = True
        s = self.engine.score(X)
        best_f1, best_t = -1, 0.5
        for t in np.linspace(0.05, 0.95, 91):
            p = (s >= t).astype(int)
            f = f1_score(yv, p, zero_division=0)
            if f > best_f1:
                best_f1, best_t = f, float(t)
        self.best_threshold = best_t
        self.engine.threshold = best_t
        for feat, w in self.feature_weights.items():
            self.rules.append((feat, 0, 1, float(w)))
        self.rules.sort(key=lambda x: x[3], reverse=True)
        for feat in self.feature_weights:
            if feat in X.columns and X[feat].nunique() > 1:
                self.bins[feat] = np.array([float(X[feat].median())])
            else:
                self.bins[feat] = np.array([])
        self.is_fitted = True
        return self

    def predict(self, X):
        if not self.has_features:
            return np.full(len(X), self.majority_class)
        return (self.engine.score(X) >= self.best_threshold).astype(int)

    def predict_proba(self, X):
        if not self.has_features:
            p = np.zeros((len(X), 2)); p[:, self.majority_class] = 1.0
            return p
        s = np.clip(self.engine.score(X), 0, 1)
        return np.column_stack([1 - s, s])

    def get_feature_importance(self):
        return dict(self.feature_weights)

