# 4. GRANULAR ROUGH SET LAYER
# =============================================================================
class GranularRoughSetLayer:
    def __init__(self, k=4, feature_subset=None,
                 min_granule_size=3, min_confidence=0.5):
        self.k = k; self.feature_subset = feature_subset
        self.min_granule_size = min_granule_size
        self.min_confidence = min_confidence
        self.feature_names, self.bins = [], {}
        self.equiv_class_to_counts = {}
        self.lower_approx, self.upper_approx = {}, {}
        self.upper_approx_membership = {}
        self.rules, self.rule_index = [], {}
        self.majority_class = 0
        self.is_fitted = False

    def fit(self, X, y):
        if isinstance(X, pd.DataFrame):
            if self.feature_subset is not None:
                X = X[self.feature_subset]
            self.feature_names = X.columns.tolist()
            Xa = X.values.astype(float)
        else:
            self.feature_names = [f'f{i}' for i in range(X.shape[1])]
            Xa = np.asarray(X, dtype=float)
        yv = y.values if isinstance(y, pd.Series) else np.asarray(y)
        self.majority_class = int(Counter(yv.tolist()).most_common(1)[0][0])
        self.bins = {}
        for i, col in enumerate(self.feature_names):
            v = Xa[:, i]; u = np.unique(v)
            if len(u) <= 1:
                self.bins[col] = np.array([]); continue
            k_eff = min(self.k, max(2, len(u) - 1))
            qs = np.linspace(0, 100, k_eff + 1)[1:-1]
            self.bins[col] = np.unique(np.percentile(v, qs))
        Xd = self._disc(Xa)
        self.equiv_class_to_counts = {}
        for r, l in zip(Xd, yv):
            key = tuple(int(v) for v in r)
            self.equiv_class_to_counts.setdefault(key, Counter())[int(l)] += 1
        self.lower_approx, self.upper_approx = {}, {}
        self.upper_approx_membership = {}
        for key, cnts in self.equiv_class_to_counts.items():
            tot = sum(cnts.values())
            for c in set(int(x) for x in yv):
                n_c = cnts.get(c, 0)
                if n_c > 0:
                    self.upper_approx.setdefault(c, set()).add(key)
                    self.upper_approx_membership.setdefault(c, {})[key] = n_c / tot
                if n_c == tot:
                    self.lower_approx.setdefault(c, set()).add(key)
        rv = {}
        for key, cnts in self.equiv_class_to_counts.items():
            tot = sum(cnts.values())
            if tot < self.min_granule_size: continue
            for i, b in enumerate(key):
                col = self.feature_names[i]
                slot = rv.setdefault((col, b), Counter())
                for c, x in cnts.items(): slot[c] += x
        self.rules, self.rule_index = [], {}
        for (col, b), votes in rv.items():
            tot = sum(votes.values())
            if tot < self.min_granule_size: continue
            mc, cnt = votes.most_common(1)[0]
            conf = cnt / tot
            if conf >= self.min_confidence:
                self.rules.append((col, int(b), int(mc), float(conf)))
        self.rules.sort(key=lambda x: x[3], reverse=True)
        for (col, b, c, cf) in self.rules:
            self.rule_index.setdefault((col, b), []).append((c, cf))
        self.is_fitted = True
        return self

    def _disc(self, Xa):
        out = np.zeros((Xa.shape[0], len(self.feature_names)), dtype=int)
        for i, col in enumerate(self.feature_names):
            e = self.bins.get(col, np.array([]))
            out[:, i] = 0 if len(e) == 0 else np.digitize(Xa[:, i], e, right=False)
        return out

    def membership(self, Xa):
        Xd = self._disc(Xa)
        res = []
        for r in Xd:
            key = tuple(int(v) for v in r)
            if key in self.lower_approx.get(1, set()):
                res.append(('lower', 1.0))
            elif key in self.upper_approx_membership.get(1, {}):
                res.append(('boundary', self.upper_approx_membership[1][key]))
            elif key in self.equiv_class_to_counts:
                res.append(('benign_known', 0.0))
            else:
                res.append(('unseen', 0.5))
        return res

    def _to_array(self, X):
        if isinstance(X, pd.DataFrame):
            if self.feature_subset is not None:
                X = X[self.feature_subset]
            return X.values.astype(float)
        return np.asarray(X, dtype=float)

    def predict(self, X):
        Xa = self._to_array(X)
        res = self.membership(Xa)
        out = np.empty(len(res), dtype=int)
        for i, (tier, mu) in enumerate(res):
            if tier == 'lower':
                out[i] = 1
            elif tier == 'benign_known':
                out[i] = 0
            elif tier == 'boundary':
                out[i] = int(mu >= 0.5)
            else:
                out[i] = self.majority_class
        return out

    def predict_proba(self, X):
        Xa = self._to_array(X)
        res = self.membership(Xa)
        out = np.empty((len(res), 2), dtype=float)
        for i, (tier, mu) in enumerate(res):
            if tier == 'lower':
                out[i] = [0.0, 1.0]
            elif tier == 'benign_known':
                out[i] = [1.0, 0.0]
            elif tier == 'boundary':
                out[i] = [1.0 - mu, mu]
            else:
                if self.majority_class == 1:
                    out[i] = [0.0, 1.0]
                else:
                    out[i] = [1.0, 0.0]
        return out

    def get_feature_importance(self):
        imp = Counter()
        for k, c in self.equiv_class_to_counts.items():
            t = sum(c.values())
            if t < self.min_granule_size: continue
            _, top = c.most_common(1)[0]
            if top / t < self.min_confidence: continue
            for col in self.feature_names: imp[col] += top / t
        return dict(imp)

