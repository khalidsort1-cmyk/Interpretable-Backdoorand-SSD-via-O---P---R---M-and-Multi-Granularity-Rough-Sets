LABEL_LIKE_COLUMNS = [
    'Unnamed: 0', 'index', 'id',
    # primary label (already renamed to 'label' but be safe)
    'label', 'labels',
    # alternative label columns seen across datasets
    'attack_cat', 'attack', 'attack_type', 'attack_category',
    'attack_subcategory', 'class', 'class_name', 'category',
    'subcategory', 'target', 'type', 'malicious', 'is_malicious',
    'is_attack', 'is_anomaly', 'anomaly', 'label_name', 'label_binary',
    'label_multiclass', 'attack_name', 'attack_label',
    # identifiers that can leak
    'flow_id', 'session_id', 'connection_id', 'record_id',
    'source_file', 'dataset', 'split',
]

def prep(X):
    for c in LABEL_LIKE_COLUMNS:
        if c in X.columns:
            X = X.drop(columns=[c])
    cat = X.select_dtypes(include=['object']).columns.tolist()
    Xe = X.copy()
    for c in cat:
        n = X[c].nunique()
        if n <= 1: Xe = Xe.drop(columns=[c])
        elif n <= 50:
            d = pd.get_dummies(X[c], prefix=c, drop_first=True)
            Xe = pd.concat([Xe.drop(columns=[c]), d], axis=1)
        else:
            fr = X[c].value_counts(normalize=True)
            Xe[c] = X[c].map(fr).fillna(0)
    return Xe.replace([np.inf, -np.inf], np.nan).fillna(0)

def plot_roc(y, pr, path):
    plt.figure(figsize=(9, 7))
    for n, p in pr.items():
        if p is None: continue
        p1 = p[:, 1] if p.shape[1] == 2 else p[:, 0]
        fpr, tpr, _ = roc_curve(y, p1)
        plt.plot(fpr, tpr, label=f'{n} ({roc_auc_score(y, p1):.3f})', lw=2)
    plt.plot([0, 1], [0, 1], 'k--'); plt.xlabel('FPR'); plt.ylabel('TPR')
    plt.title('ROC — Paper 2 (KAC + Granular + SSD)')
    plt.legend(loc='lower right', fontsize=7); plt.grid(alpha=0.3)
    plt.tight_layout(); plt.savefig(path, dpi=300); plt.close()

def plot_pr(y, pr, path):
    plt.figure(figsize=(9, 7))
    for n, p in pr.items():
        if p is None: continue
        p1 = p[:, 1] if p.shape[1] == 2 else p[:, 0]
