def build_all(avail_kac, avail_outgoing, avail_ssd):
    clfs = {}
    clfs['SSD Only'] = SSDOnly()
    clfs['SSD (all features)'] = SSDAllClassifier(feature_subset=avail_ssd)
    clfs['SSD-GR (all features)'] = GranularRoughSetLayer(
        k=4, feature_subset=avail_ssd)

    clfs['KAC (flat)'] = KhalidAlminshidClassifier(feature_subset=avail_kac)
    clfs['KAC (all outgoing)'] = KhalidAlminshidClassifier(
        feature_subset=avail_outgoing)

    clfs['KAC-GR (coarse k=2)'] = KACGranularClassifier(
        k_values=[2], k_weights=[1.0], feature_subset=avail_kac)
    clfs['KAC-GR (medium k=4)'] = KACGranularClassifier(
        k_values=[4], k_weights=[1.0], feature_subset=avail_kac)
    clfs['KAC-GR (fine k=8)'] = KACGranularClassifier(
        k_values=[8], k_weights=[1.0], feature_subset=avail_kac)
    clfs['KAC-GR (multi-level)'] = KACGranularClassifier(
        k_values=[2, 4, 8], k_weights=[0.2, 0.5, 0.3], feature_subset=avail_kac)

    # ---- FIX 2: single-granularity k=4 over the full outgoing set ----
    clfs['KAC-GR (all outgoing)'] = KACGranularClassifier(
        k_values=[4], k_weights=[1.0], feature_subset=avail_outgoing)

    # ---- FIX 3: lower min sizes for standalone rough-set baselines ----
    clfs['Granular Rough'] = GranularRoughSetLayer(
        k=4, min_granule_size=2, min_confidence=0.4)
    clfs['Rough Set (ALONE)'] = RoughSetClassifier(
        n_bins=6, min_class_size=2, min_samples_per_bin=3,
        min_confidence=0.4)

    clfs['Random Forest'] = RandomForestClassifier(
        n_estimators=100, random_state=42, n_jobs=-1)
    if HAS_XGB:
        clfs['XGBoost'] = XGBClassifier(
            n_estimators=100, learning_rate=0.1, random_state=42,
            use_label_encoder=False, eval_metric='logloss')
    clfs['Logistic Regression'] = LogisticRegression(max_iter=1000, random_state=42)
    clfs['Decision Tree'] = DecisionTreeClassifier(random_state=42)
    clfs['KNN'] = KNeighborsClassifier(n_neighbors=5)
    clfs['Linear SVM'] = LinearSVC(max_iter=10000, random_state=42, dual='auto')
    clfs['Gaussian NB'] = GaussianNB()
    clfs['LDA'] = LinearDiscriminantAnalysis()
    clfs['Gradient Boosting'] = GradientBoostingClassifier(n_estimators=100, random_state=42)
    clfs['AdaBoost'] = AdaBoostClassifier(random_state=42)
    clfs['Extra Trees'] = ExtraTreesClassifier(n_estimators=100, random_state=42, n_jobs=-1)
    clfs['Deep MLP'] = MLPClassifier(hidden_layer_sizes=(64, 32),
                                      max_iter=200, random_state=42)
    return clfs

