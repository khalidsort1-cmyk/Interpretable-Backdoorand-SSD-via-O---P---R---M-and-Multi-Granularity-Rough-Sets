def derive_kac_features(df):
    """Derive KAC + outgoing features with normalised column matching."""
    df = df.copy()
    cols = {_norm(c): c for c in df.columns}

    def pick(candidates):
        for c in candidates:
            key = _norm(c)
            if key in cols:
                return df[cols[key]]
        return None

    for new_name, cands in OUTGOING_SOURCE_MAP.items():
        if new_name in df.columns:
            continue
        s = pick(cands)
        if s is not None:
            df[new_name] = pd.to_numeric(s, errors='coerce').fillna(0).astype(float)

    if 'out_pkt_repetition_count' not in df.columns:
        if 'out_src_pkts' in df.columns:
            df['out_pkt_repetition_count'] = df['out_src_pkts'].clip(lower=0)
        else:
            df['out_pkt_repetition_count'] = 1.0
    rep = df['out_pkt_repetition_count'].astype(float).clip(lower=1)

    if 'out_pkt_size_match' not in df.columns:
        if 'out_src_mean_size' in df.columns:
            ms = df['out_src_mean_size'].astype(float).abs()
            df['out_pkt_size_match'] = (1.0 / (1.0 + ms / 1000.0)).clip(0, 1)
        elif 'out_src_bytes' in df.columns:
            ms = (df['out_src_bytes'].astype(float) / rep).abs()
            df['out_pkt_size_match'] = (1.0 / (1.0 + ms / 1000.0)).clip(0, 1)
        else:
            df['out_pkt_size_match'] = 0.5

    if 'out_pkt_interval_match' not in df.columns:
        if 'out_src_inter_pkt' in df.columns:
            x = df['out_src_inter_pkt'].astype(float).fillna(0).clip(lower=0)
            df['out_pkt_interval_match'] = np.exp(-x / 100.0).clip(0, 1)
        else:
            df['out_pkt_interval_match'] = 0.5

    if 'out_pkt_same_dest_port_ratio' not in df.columns:
        c = pick(['ct_dst_sport_ltm', 'ct_dst_ltm', 'same_dst_port_ratio',
                  'dst_host_same_src_port_rate',
                  'dst_host_same_src_port_rate_'])
        if c is not None:
            x = pd.to_numeric(c, errors='coerce').fillna(0).clip(lower=0)
            df['out_pkt_same_dest_port_ratio'] = (1.0 - np.exp(-x / 10.0)).clip(0, 1)
        else:
            df['out_pkt_same_dest_port_ratio'] = (1.0 - np.exp(-rep / 20.0)).clip(0, 1)

    if 'out_pkt_byte_match' not in df.columns:
        if 'out_src_bytes' in df.columns:
            bpp = (df['out_src_bytes'].astype(float) / rep).abs()
            df['out_pkt_byte_match'] = (1.0 / (1.0 + bpp / 1000.0)).clip(0, 1)
        else:
            df['out_pkt_byte_match'] = 0.5

    p = df.get('out_src_pkts', pd.Series(1.0, index=df.index)).astype(float).clip(lower=1)
    b = df.get('out_src_bytes', pd.Series(0.0, index=df.index)).astype(float)

    if 'out_mean_pkt_size' not in df.columns:
        df['out_mean_pkt_size'] = (b / p)
    if 'out_log_src_pkts' not in df.columns:
        df['out_log_src_pkts'] = np.log1p(p.clip(lower=0))
    if 'out_log_src_bytes' not in df.columns:
        df['out_log_src_bytes'] = np.log1p(b.clip(lower=0))
    if 'out_pkt_size_cv' not in df.columns:
        if 'out_src_std_pkt' in df.columns:
            df['out_pkt_size_cv'] = (
                df['out_src_std_pkt'].astype(float) /
                (df['out_mean_pkt_size'].abs() + 1.0))
        else:
            df['out_pkt_size_cv'] = 0.0
    if 'out_pkt_size_range' not in df.columns:
        if 'out_src_max_pkt' in df.columns and 'out_src_min_pkt' in df.columns:
            df['out_pkt_size_range'] = (
                df['out_src_max_pkt'].astype(float) -
                df['out_src_min_pkt'].astype(float))
        else:
            df['out_pkt_size_range'] = 0.0
    if 'out_bytes_per_sec' not in df.columns:
        df['out_bytes_per_sec'] = df.get('out_src_load', b)
    if 'out_ttl_per_pkt' not in df.columns:
        df['out_ttl_per_pkt'] = (
            df.get('out_src_ttl', pd.Series(0.0, index=df.index)).astype(float) / p)
    if 'out_win_per_byte' not in df.columns:
        df['out_win_per_byte'] = (
            df.get('out_src_win', pd.Series(0.0, index=df.index)).astype(float) / (b + 1.0))

    if 'khalid_risk_score' not in df.columns:
        engine = KhalidAlminshidEngine()
        df['khalid_risk_score'] = engine.score(df)

    for c in df.columns:
        if df[c].dtype.kind in 'fc':
            df[c] = df[c].replace([np.inf, -np.inf], np.nan).fillna(0.0)

    found = [f for f in OUTGOING_SOURCE_MAP if f in df.columns]
    print(f"   [derive] raw outgoing columns found: {len(found)} → {found}")
    const_flags = []
    for f in ['out_pkt_repetition_count', 'out_pkt_size_match',
              'out_pkt_interval_match', 'out_pkt_same_dest_port_ratio',
              'out_pkt_byte_match']:
        if f in df.columns and df[f].nunique() <= 1:
            const_flags.append(f"{f}={df[f].iloc[0]}")
    if const_flags:
        print(f"   ⚠️  CONSTANT KAC features (KAC score may collapse): "
              f"{const_flags}")
    else:
        print("   ✅ All KAC features are non-constant")

    return df


def derive_stepping_stone_features(df):
    """Derive all classical SSD features into ssd_* namespace."""
    df = df.copy()
    cols = {_norm(c): c for c in df.columns}

    def pick(candidates):
        for c in candidates:
            key = _norm(c)
            if key in cols:
                return pd.to_numeric(df[cols[key]], errors='coerce').fillna(0)
        return None

    s_iat_mean = pick(['sinpkt', 'src_inter_pkt', 'fwd_iat_mean',
                       'flow_iat_mean', 'mean_time_between_fwd_packets',
                       'out_src_inter_pkt'])
    s_iat_min  = pick(['fwd_iat_min', 'min_time_between_fwd_packets',
                       'flow_iat_min', 'out_src_iat_min'])
    s_iat_max  = pick(['fwd_iat_max', 'max_time_between_fwd_packets',
                       'flow_iat_max', 'out_src_iat_max'])
    s_iat_std  = pick(['fwd_iat_std', 'std_time_between_fwd_packets',
                       'out_src_jitter', 'flow_iat_std'])
    s_pkts     = pick(['spkts', 'src_pkts', 'fwd_packets',
                       'total_fwd_packets', 'out_src_pkts'])
    s_bytes    = pick(['sbytes', 'src_bytes', 'fwd_bytes',
                       'total_length_of_fwd_packets', 'out_src_bytes'])
    s_mean     = pick(['smean', 'fwd_pkt_len_mean', 'out_src_mean_size',
                       'average_packet_size'])
    s_std      = pick(['fwd_pkt_len_std', 'out_src_std_pkt',
                       'fwd_packet_length_std'])
    s_jit      = pick(['sjit', 'out_src_jitter'])
    s_load     = pick(['sload', 'out_src_load'])
    s_rate     = pick(['srate', 'fwd_pkts_s', 'out_src_rate'])

    d_iat_mean = pick(['dinpkt', 'dst_inter_pkt', 'bwd_iat_mean',
                       'mean_time_between_bwd_packets'])
    d_pkts     = pick(['dpkts', 'dst_pkts', 'bwd_packets',
                       'total_backward_packets'])
    d_bytes    = pick(['dbytes', 'dst_bytes', 'bwd_bytes',
                       'total_length_of_bwd_packets'])
    d_mean     = pick(['dmean', 'bwd_pkt_len_mean'])
    d_std      = pick(['bwd_pkt_len_std'])
    d_jit      = pick(['djit', 'bwd_iat_std'])
    d_load     = pick(['dload'])
    d_rate     = pick(['drate', 'bwd_pkts_s'])

    if 'ssd_avg_inter_hop_delay' not in df.columns:
        if s_iat_mean is not None:
            df['ssd_avg_inter_hop_delay'] = s_iat_mean.clip(lower=0)
        elif 'avg_inter_hop_delay' in df.columns:
            df['ssd_avg_inter_hop_delay'] = df['avg_inter_hop_delay'].astype(float)
        else:
            df['ssd_avg_inter_hop_delay'] = 0.0
    if 'avg_inter_hop_delay' not in df.columns:
        df['avg_inter_hop_delay'] = df['ssd_avg_inter_hop_delay']

    if 'ssd_min_inter_hop_delay' not in df.columns:
        df['ssd_min_inter_hop_delay'] = (s_iat_min.clip(lower=0)
            if s_iat_min is not None
            else df['ssd_avg_inter_hop_delay'] * 0.5)
    if 'ssd_max_inter_hop_delay' not in df.columns:
        df['ssd_max_inter_hop_delay'] = (s_iat_max.clip(lower=0)
            if s_iat_max is not None
            else df['ssd_avg_inter_hop_delay'] * 2.0)
    if 'ssd_std_inter_hop_delay' not in df.columns:
        df['ssd_std_inter_hop_delay'] = (s_iat_std.clip(lower=0)
            if s_iat_std is not None else 0.0)
    if 'ssd_median_inter_hop_delay' not in df.columns:
        df['ssd_median_inter_hop_delay'] = df['ssd_avg_inter_hop_delay']

    if 'ssd_rtt_ratio' not in df.columns:
        if 'rtt_ratio' in df.columns:
            df['ssd_rtt_ratio'] = df['rtt_ratio'].astype(float)
        elif d_iat_mean is not None and s_iat_mean is not None:
            df['ssd_rtt_ratio'] = (
                d_iat_mean.clip(lower=1e-6) / s_iat_mean.clip(lower=1e-6)
            ).clip(upper=100)
        elif d_jit is not None and s_jit is not None:
            df['ssd_rtt_ratio'] = (
                d_jit.clip(lower=1e-6) / s_jit.clip(lower=1e-6)
            ).clip(upper=100)
        else:
            df['ssd_rtt_ratio'] = 1.0
    if 'rtt_ratio' not in df.columns:
        df['rtt_ratio'] = df['ssd_rtt_ratio']

    if 'ssd_delay_deviation' not in df.columns:
        df['ssd_delay_deviation'] = (
            df['ssd_std_inter_hop_delay'] /
            df['ssd_avg_inter_hop_delay'].clip(lower=1e-6)
        ).clip(upper=100)
    if 'ssd_timing_jitter' not in df.columns:
        df['ssd_timing_jitter'] = (s_jit.clip(lower=0)
            if s_jit is not None else df['ssd_std_inter_hop_delay'])

    if 'ssd_mean_size_ratio' not in df.columns:
        if d_mean is not None and s_mean is not None:
            df['ssd_mean_size_ratio'] = (
                s_mean.clip(lower=1e-6) / d_mean.clip(lower=1e-6)
            ).clip(upper=1000)
        elif d_bytes is not None and s_bytes is not None and \
                d_pkts is not None and s_pkts is not None:
            df['ssd_mean_size_ratio'] = (
                (s_bytes / s_pkts.clip(lower=1)) /
                (d_bytes / d_pkts.clip(lower=1)).clip(lower=1e-6)
            ).clip(upper=1000)
        else:
            df['ssd_mean_size_ratio'] = 1.0

    if 'ssd_pkt_size_match_ratio' not in df.columns:
        r = df['ssd_mean_size_ratio'].clip(lower=1e-6)
        df['ssd_pkt_size_match_ratio'] = (
            1.0 / (1.0 + np.abs(np.log(r)))).clip(0, 1)

    if 'ssd_pkt_size_correlation' not in df.columns:
        if s_std is not None and d_std is not None:
            df['ssd_pkt_size_correlation'] = (
                1.0 / (1.0 + (s_std - d_std).abs())).clip(0, 1)
        else:
            df['ssd_pkt_size_correlation'] = df['ssd_pkt_size_match_ratio']

    if 'ssd_byte_count_correlation' not in df.columns:
        if s_bytes is not None and d_bytes is not None:
            num = (s_bytes - d_bytes).abs()
            den = (s_bytes + d_bytes).clip(lower=1)
            df['ssd_byte_count_correlation'] = (1.0 - num / den).clip(0, 1)
        else:
            df['ssd_byte_count_correlation'] = 0.5

    if 'ssd_pkt_ratio' not in df.columns:
        if s_pkts is not None and d_pkts is not None:
            df['ssd_pkt_ratio'] = (
                s_pkts.clip(lower=1) / d_pkts.clip(lower=1)
            ).clip(upper=1000)
        else:
            df['ssd_pkt_ratio'] = 1.0
    if 'ssd_byte_ratio' not in df.columns:
        if s_bytes is not None and d_bytes is not None:
            df['ssd_byte_ratio'] = (
                s_bytes.clip(lower=1) / d_bytes.clip(lower=1)
            ).clip(upper=1000)
        else:
            df['ssd_byte_ratio'] = 1.0
    if 'ssd_pkt_count_match' not in df.columns:
        r = df['ssd_pkt_ratio'].clip(lower=1e-6)
        df['ssd_pkt_count_match'] = (1.0 / (1.0 + np.abs(np.log(r)))).clip(0, 1)
    if 'ssd_byte_count_match' not in df.columns:
        r = df['ssd_byte_ratio'].clip(lower=1e-6)
        df['ssd_byte_count_match'] = (1.0 / (1.0 + np.abs(np.log(r)))).clip(0, 1)

    if 'ssd_throughput_ratio' not in df.columns:
        if s_load is not None and d_load is not None:
            df['ssd_throughput_ratio'] = (
                s_load.clip(lower=1e-6) / d_load.clip(lower=1e-6)
            ).clip(upper=1000)
        else:
            df['ssd_throughput_ratio'] = 1.0
    if 'ssd_rate_ratio' not in df.columns:
        if s_rate is not None and d_rate is not None:
            df['ssd_rate_ratio'] = (
                s_rate.clip(lower=1e-6) / d_rate.clip(lower=1e-6)
            ).clip(upper=1000)
        else:
            df['ssd_rate_ratio'] = 1.0

    if 'ssd_size_entropy' not in df.columns:
        if s_std is not None:
            var = (s_std ** 2).clip(lower=1e-6)
            df['ssd_size_entropy'] = 0.5 * np.log(2 * np.pi * np.e * var)
        else:
            df['ssd_size_entropy'] = 0.0
    if 'ssd_time_entropy' not in df.columns:
        if s_iat_std is not None:
            var = (s_iat_std ** 2).clip(lower=1e-6)
            df['ssd_time_entropy'] = 0.5 * np.log(2 * np.pi * np.e * var)
        else:
            df['ssd_time_entropy'] = 0.0

    for c in df.columns:
        if df[c].dtype.kind in 'fc':
            df[c] = df[c].replace([np.inf, -np.inf], np.nan).fillna(0.0)
    return df

