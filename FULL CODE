    }

def generate_dataset(num_samples=10000, attack_ratio=0.20, difficulty='very_hard',
                     random_state=42):
    presets = {
        'hard':      {'kac_mal_mean': 0.90, 'kac_std': 0.05, 'kac_ben_mean': 0.20},
        'very_hard': {'kac_mal_mean': 0.80, 'kac_std': 0.10, 'kac_ben_mean': 0.35},
        'extreme':   {'kac_mal_mean': 0.68, 'kac_std': 0.14, 'kac_ben_mean': 0.50},
    }
    p = presets.get(difficulty, presets['very_hard'])
    np.random.seed(random_state)
    rows = []
    for _ in range(num_samples):
        is_mal = np.random.random() < attack_ratio
        chain = [{'delay': np.random.uniform(0.02, 1.5),
                  'duration': np.random.exponential(1.2 if is_mal else 100),
                  'pkt_in': np.random.poisson(10), 'pkt_out': np.random.poisson(10),
                  'bytes_in': np.random.randint(20, 200) if is_mal else np.random.randint(200, 9000),
                  'bytes_out': np.random.randint(20, 200) if is_mal else np.random.randint(200, 9000)}
                 for _ in range(np.random.randint(1, 8))]
        ka = _kac_from_chain(chain, is_mal, p['kac_mal_mean'], p['kac_std'],
                             p['kac_ben_mean'], p['kac_std'])
        row = dict(ka)
        row['avg_inter_hop_delay'] = np.mean([h['delay'] for h in chain])
        row['rtt_ratio'] = np.random.uniform(0.1, 4.0)
        row['num_hops'] = len(chain)
        row['label'] = int(is_mal)
        rows.append(row)
    return pd.DataFrame(rows)

