class SSDOnly:
    def __init__(self):
        self.fitted = False; self.has_features = False
        self.majority_class = 0
    def fit(self, X, y):
        req = ['avg_inter_hop_delay', 'rtt_ratio']
        self.has_features = all(c in X.columns for c in req)
        yv = y.values if isinstance(y, pd.Series) else np.asarray(y)
        if not self.has_features:
            self.majority_class = int(np.argmax(np.bincount(yv)))
            self.fitted = True; return self
        d = X['avg_inter_hop_delay'].values; r = X['rtt_ratio'].values
        best_f1, best = -1, (None, None)
        for td in np.linspace(d.min(), d.max(), 20):
            for tr in np.linspace(r.min(), r.max(), 20):
                p = ((d > td) | (r > tr)).astype(int)
                f = f1_score(yv, p, zero_division=0)
                if f > best_f1: best_f1, best = f, (td, tr)
        self.td, self.tr = best; self.fitted = True; return self
    def predict(self, X):
        if not self.has_features:
            return np.full(len(X), self.majority_class)
        d = X['avg_inter_hop_delay'].values; r = X['rtt_ratio'].values
        return ((d > self.td) | (r > self.tr)).astype(int)
    def predict_proba(self, X):
        p = self.predict(X); return np.column_stack([1 - p, p])

class SSDAllClassifier:
    def __init__(self, feature_subset=None):
        self.feature_subset = feature_subset
        self.threshold = 0.5
        self.majority_class = 0
        self.weights = {}
        self.means = None
        self.stds = None
        self.feats = []
        self.is_fitted = False

    def fit(self, X, y):
        yv = y.values if isinstance(y, pd.Series) else np.asarray(y)
        self.majority_class = int(np.argmax(np.bincount(yv.astype(int))))
        feats = self.feature_subset if self.feature_subset is not None else \
                [c for c in STEPPING_STONE_FEATURES if c in X.columns]
        feats = [f for f in feats if f in X.columns]
        if not feats:
            self.is_fitted = True
            return self
        Xs = X[feats].astype(float)
        self.means = Xs.mean()
        self.stds = Xs.std().replace(0, 1).fillna(1)
        Z = ((Xs - self.means) / self.stds).fillna(0)
        w = {}
        for f in feats:
            m0 = Z[yv == 0][f].mean() if (yv == 0).any() else 0.0
            m1 = Z[yv == 1][f].mean() if (yv == 1).any() else 0.0
            w[f] = float(abs(m1 - m0))
        tot = sum(w.values()) or 1.0
        self.weights = {k: v / tot for k, v in w.items()}
        self.feats = feats
        s = self._score(Xs)
        best_f1, best_t = -1, float(np.median(s))
        for t in np.linspace(s.min(), s.max(), 101):
            p = (s >= t).astype(int)
            f = f1_score(yv, p, zero_division=0)
            if f > best_f1:
                best_f1, best_t = f, float(t)
        self.threshold = best_t
        self.is_fitted = True
        return self

    def _score(self, Xs):
        Z = ((Xs[self.feats] - self.means) / self.stds).fillna(0)
        s = np.zeros(len(Z))
        for f, w in self.weights.items():
            s += w * np.abs(Z[f].values)
        return s

    def predict(self, X):
        if not self.is_fitted or not self.weights:
            return np.full(len(X), self.majority_class)
        s = self._score(X)
        return (s >= self.threshold).astype(int)

    def predict_proba(self, X):
        if not self.is_fitted or not self.weights:
            p = np.zeros((len(X), 2)); p[:, self.majority_class] = 1.0
            return p
        s = self._score(X)
        rng = abs(self.threshold) + 1e-6
        s_norm = np.clip((s - self.threshold) / rng * 0.5 + 0.5, 0, 1)
        return np.column_stack([1 - s_norm, s_norm])

    def get_feature_importance(self):
        return dict(self.weights)

