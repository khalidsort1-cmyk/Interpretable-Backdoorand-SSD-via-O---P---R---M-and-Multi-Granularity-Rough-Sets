# 5. KAC + GRANULAR FUSION (multi-granularity)
# =============================================================================
class KACGranularClassifier:
    def __init__(self, k_values=(2, 4, 8), k_weights=(0.2, 0.5, 0.3),
                 feature_subset=None, min_granule_size=3, min_confidence=0.5):
        self.k_values = list(k_values)
        self.k_weights = list(k_weights)
        assert abs(sum(self.k_weights) - 1.0) < 1e-6
        self.feature_subset = feature_subset
        self.min_granule_size = min_granule_size
        self.min_confidence = min_confidence
        self.kac = KhalidAlminshidClassifier(feature_subset=feature_subset)
        self.layers = {}
        self.is_fitted = False

    def fit(self, X, y):
        self.kac.fit(X, y)
        self.layers = {}
        for k in self.k_values:
            l = GranularRoughSetLayer(
                k=k, feature_subset=self.feature_subset,
                min_granule_size=self.min_granule_size,
                min_confidence=self.min_confidence)
            l.fit(X, y)
            self.layers[k] = l
        self.is_fitted = True
        return self

    def _decide(self, X):
        ks = self.kac.engine.score(X)
        kf = (ks >= self.kac.best_threshold).astype(int)
        Xl = X[self.feature_subset] if self.feature_subset is not None else X
        Xla = Xl.values.astype(float)
        per_level = {}
        for k, l in self.layers.items():
            res = l.membership(Xla)
            per_level[k] = {'tiers': [r[0] for r in res],
                            'mus': np.array([r[1] for r in res])}
        preds, tiers = [], []
        for i in range(len(X)):
            v1, v0 = 0.0, 0.0
            has_def = has_pos = False
            unseen_w = 0.0
            for k, w in zip(self.k_values, self.k_weights):
                t = per_level[k]['tiers'][i]
                mu = per_level[k]['mus'][i]
                if t == 'lower':
                    v1 += w; has_def = True
                elif t == 'boundary':
                    has_pos = True; v1 += w * mu; v0 += w * (1 - mu)
                elif t == 'benign_known':
                    v0 += w
                else:
                    unseen_w += w
                    v1 += w * ks[i]; v0 += w * (1 - ks[i])
            if v1 + v0 == 0:
                p = int(kf[i])
                tl = 'definite_backdoor' if p == 1 else 'definitely_benign'
            else:
                p = int(v1 >= v0)
                if has_def and not has_pos and unseen_w == 0:
                    tl = 'definite_backdoor'
                elif has_pos or (unseen_w > 0 and kf[i] == 1):
                    tl = 'possible_backdoor'
                else:
                    tl = 'definitely_benign'
            preds.append(p); tiers.append(tl)
        return np.array(preds), tiers

    def predict(self, X):
        p, _ = self._decide(X); return p

    def predict_proba(self, X):
        ks = self.kac.engine.score(X)
        Xl = X[self.feature_subset] if self.feature_subset is not None else X
        Xla = Xl.values.astype(float)
        per_level = {}
        for k, l in self.layers.items():
            res = l.membership(Xla)
            per_level[k] = {'tiers': [r[0] for r in res],
                            'mus': np.array([r[1] for r in res])}
        probs = np.empty(len(X), dtype=float)
        for i in range(len(X)):
            v1, v0 = 0.0, 0.0
            for k, w in zip(self.k_values, self.k_weights):
                t = per_level[k]['tiers'][i]
                mu = per_level[k]['mus'][i]
                if t == 'lower':
                    v1 += w
                elif t == 'boundary':
                    v1 += w * mu; v0 += w * (1 - mu)
                elif t == 'benign_known':
                    v0 += w
                else:
                    v1 += w * ks[i]; v0 += w * (1 - ks[i])
            tot = v1 + v0
            probs[i] = (v1 / tot) if tot > 0 else ks[i]
        probs = np.clip(probs, 0.0, 1.0)
        return np.column_stack([1 - probs, probs])

    def predict_with_tier(self, X):
        return self._decide(X)

    @property
    def rules(self):
        med = self.layers.get(4) or (self.layers[min(self.layers)] if self.layers else None)
        return med.rules if med else []

    @property
    def bins(self):
        med = self.layers.get(4) or (self.layers[min(self.layers)] if self.layers else None)
        return med.bins if med else {}

    def get_feature_importance(self):
        imp = Counter()
        for k, l in self.layers.items():
            for f, v in l.get_feature_importance().items():
                imp[f] += v
        for f, w in self.kac.feature_weights.items():
            imp[f] += w
        return dict(imp)

